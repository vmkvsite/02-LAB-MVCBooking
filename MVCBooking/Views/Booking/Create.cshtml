@model MVCBooking.Models.HotelBooking

<h2>Dodaj rezervaciju</h2>

<form asp-action="CreateBooking" method="post">
    <div class="form-group">
        <label asp-for="GuestName">Ime gosta</label>
        <input asp-for="GuestName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="RoomNumber">Broj sobe</label>
        <input asp-for="RoomNumber" type="number" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Dodaj</button>
</form>

<a asp-action="Index">Povratak na listu rezervacija</a>
